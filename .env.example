# Copy to .env (or point local.json "env" at an existing env file). Never commit the real one.
#
# Jev goes straight to the TypeSafe console. No OpenRouter, no third-party router.
# Create the key at https://console.typesafe.ai/keys -- the console grants a small
# monthly credit, so the first hunt may cost nothing.
#   TYPESAFE_API_KEY=apikey_...
# Any of these names works: TYPESAFE_API_KEY, JEV. OPENROUTER_API_KEY is still
# read as a last resort if you already have one.
TYPESAFE_API_KEY=

YOUTUBE_DATA_API_KEY=            # Google Cloud, YouTube Data API v3 key. Free, 10,000 units/day. A full hunt uses about 40.
APIFY_API_TOKEN=                 # Only for Instagram competitors. apify/instagram-scraper, about $0.0023 per post returned.
INSTAGRAM_ACCESS_TOKEN=          # Optional, My Studio only: Instagram Login flavor token for your own account (graph.instagram.com).